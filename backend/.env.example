# Copy to .env and adjust. Values below match deploy/docker-compose.yml.
APP_ENV=development
HTTP_ADDR=:8080

# Runtime role: subject to row-level security. Never use the owner role here.
DATABASE_URL=postgres://callcenter_app:callcenter_app@localhost:55432/callcenter?sslmode=disable
# Owner role: used only by `cli migrate`.
MIGRATIONS_DATABASE_URL=postgres://callcenter:callcenter@localhost:55432/callcenter?sslmode=disable

# Base URL of the Next.js app, used for links in emails.
WEB_BASE_URL=http://localhost:3100

SESSION_TTL=720h
# Peers allowed to set X-Forwarded-For (the Next.js server). Comma-separated CIDRs.
TRUSTED_PROXIES=127.0.0.1/32,::1/128

SMTP_HOST=localhost
SMTP_PORT=11025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="CallCenter <no-reply@callcenter.local>"

# LiveKit (media server). Dev values match deploy/livekit/livekit.yaml.
LIVEKIT_URL=http://localhost:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-devsecret-devsecret-devsecret

# Call recordings: S3-compatible object store (MinIO in development).
STORAGE_ENDPOINT=localhost:19000
STORAGE_PUBLIC_ENDPOINT=localhost:19000
# Where the recorder (running in the media network) uploads to.
STORAGE_EGRESS_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=callcenter
STORAGE_SECRET_KEY=callcenter-dev-secret
STORAGE_BUCKET=recordings
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=false
