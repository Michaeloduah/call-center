# Base URL of the Go API. Only the Next.js server talks to it; it is never exposed to browsers.
API_BASE_URL=http://localhost:8080

# Public origin of this app, used to build the widget embed snippet and its iframe URL.
WEB_PUBLIC_URL=http://localhost:3100

# Development only: lets /admin/billing/fake-checkout simulate a payment. Must match the API's
# BILLING_FAKE_SECRET. Leave both unset in production.
# BILLING_FAKE=true
# BILLING_FAKE_SECRET=fake-billing-dev-secret
